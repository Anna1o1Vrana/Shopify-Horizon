<style>
  /* ============================================
     BASE / MOBILE
     ============================================ */

  .product-tabs {
    width: 100%;
  }

  .product-tabs__item {
    border-bottom: 1px solid #e0e0e0;
  }

  .product-tabs__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
  }

  .product-tabs__summary::-webkit-details-marker {
    display: none;
  }

  .product-tabs__title {
    font-size: 14px;
    line-height: 1.4;
    font-weight: 500;
    color: #1a1a1a;
  }

  .product-tabs__icon {
    position: relative;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  /* Plus */
  .product-tabs__icon::before,
  .product-tabs__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 1px;
    background-color: #1a1a1a;
    transform: translate(-50%, -50%);
  }

  .product-tabs__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform 0.2s ease;
  }

  /* Minus when opened */
  .product-tabs__item[open] .product-tabs__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .product-tabs__content {
    padding: 4px 0 20px;
  }

  .product-tabs__inner {
    font-size: 14px;
    line-height: 1.6;
  }

  .product-tabs__inner p {
    margin: 0 0 16px;
  }

  .product-tabs__inner p:last-child {
    margin-bottom: 0;
  }

  .product-tabs__inner ul {
    margin: 0;
    padding-left: 20px;
  }

  .product-tabs__inner li + li {
    margin-top: 8px;
  }


  /* ============================================
     DESKTOP
     ============================================ */

     @media screen and (min-width: 768px) {

        .product-tabs {
          display: grid;
          grid-template-columns: repeat(4, max-content) 1fr;
          align-items: start;
          width: 100%;
          border-bottom: 1px solid #1a1a1a;
          position: relative;
        }
      
        /*
         * Each <details> stops behaving as a single layout item.
         * Its <summary> and content become direct grid items.
         */

         .first-summary {
            grid-template-column: 1/2;
            grid-row: 1/2;
        }

        .second-summary {
            grid-column: 2/3;
            grid-row: 1/2;
        }

        .third-summary {
            grid-column: 3/4;
            grid-row: 1/2;
        }

        .fourth-summary {
            grid-column: 1/2;
            grid-row: 1/2;
        }

        .product-tabs__item {
          display: contents;
          border: 0;
          margin: 0;
        }
      
        /*
         * TAB HEADER
         */
        .product-tabs__summary {
          position: relative;
          display: flex;
          align-items: center;
      
          padding: 8px 16px 12px;
      
          cursor: pointer;
          list-style: none;
        }
      
        .product-tabs__summary::-webkit-details-marker {
          display: none;
        }
      
        .product-tabs__item:first-child .product-tabs__summary {
          padding-left: 0;
        }
      
        /*
         * We don't need the mobile +/- icon on desktop.
         */
        .product-tabs__icon {
          display: none;
        }
      
        /*
         * TAB TITLE
         */
        .product-tabs__title {
          font-size: 13px;
          line-height: 1.4;
          font-weight: 400;
          color: #757575;
      
          white-space: nowrap;
      
          transition:
            color 0.2s ease,
            font-weight 0.2s ease;
        }
      
        /*
         * Hover
         */
        .product-tabs__summary:hover .product-tabs__title {
          color: #1a1a1a;
        }
      
        /*
         * Active tab
         */
        .product-tabs__item[open] .product-tabs__title {
          color: #1a1a1a;
          font-weight: 600;
        }
      
        /*
         * Active tab underline
         */
        .product-tabs__item[open] .product-tabs__summary::before {
          content: '';
      
          position: absolute;
          left: 0;
          right: 0;
          bottom: -1px;
      
          height: 2px;
      
          background-color: #1a1a1a;
      
          z-index: 2;
        }
      
        /*
         * Separator dots
         */
        .product-tabs__item:not(:last-child) .product-tabs__summary::after {
          content: '';
      
          position: absolute;
          right: 0;
          top: 50%;
      
          width: 3px;
          height: 3px;
      
          border-radius: 50%;
          background-color: #1a1a1a;
      
          transform: translate(50%, -50%);
        }
      
        /*
         * TAB CONTENT
         *
         * Every content block occupies exactly the second grid row.
         */
        .product-tabs__content {
          grid-column: 1 / 4;
          grid-row: 2/3;
          width: 100%;
          padding: 24px 0 0;
        }
      
        /*
         * Only active tab content is visible.
         */
        .product-tabs__item:not([open]) .product-tabs__content {
          display: none;
        }
      }
</style>


<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('[data-product-tabs]');

    if (!tabs.length) return;

    tabs.forEach((tabsContainer) => {
      const items = tabsContainer.querySelectorAll('.product-tabs__item');

      if (!items.length) return;

      /*
       * Desktop:
       * behaves like traditional tabs.
       * Only one <details> can be open.
       */
      const handleDesktopTabs = () => {
        if (window.innerWidth >= 768) {
          items.forEach((item) => {
            item.addEventListener('toggle', () => {
              if (item.open) {
                items.forEach((otherItem) => {
                  if (otherItem !== item) {
                    otherItem.open = false;
                  }
                });
              }
            });
          });
        }
      };

      handleDesktopTabs();

      /*
       * Mobile:
       * Accordion behavior.
       *
       * If you want multiple tabs to stay open simultaneously,
       * remove this toggle listener.
       */
      items.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (window.innerWidth < 768 && item.open) {
            items.forEach((otherItem) => {
              if (otherItem !== item) {
                otherItem.open = false;
              }
            });
          }
        });
      });
    });
  });
</script>

