<details class="product-tabs__item">

    <summary class="product-tabs__summary">
  
      <span class="product-tabs__title">
        {{ block.settings.title | escape }}
      </span>
  
      <span
        class="product-tabs__icon"
        aria-hidden="true"
      ></span>
  
    </summary>
  
    <div class="product-tabs__content">
  
      <article class="product-tabs__inner">
        {{ block.settings.content }}
      </article>
  
    </div>
  
  </details>
  
  {% schema %}
  
  {
    "name": "Product tab",
  
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Product details"
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "Content",
        "default": "<p>Add your content here.</p>"
      }
    ],
  
    "presets": [
      {
        "name": "Product tab"
      }
    ]
  }
  
  {% endschema %}