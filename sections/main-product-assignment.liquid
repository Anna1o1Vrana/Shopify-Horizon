{{ 'product-assignment.css' | asset_url | stylesheet_tag }}

{{ 'fuelerate.css' | asset_url | stylesheet_tag }}

<style>
  @font-face {
    font-family: "Recoleta";
    src: url("{{ 'Recoleta Regular.woff2' | asset_url }}") format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
</style>

{% liquid
  assign product_resource = closest.product | default: product

  if product_resource == blank
    assign product_resource = product
  endif

  assign current_variant = product_resource.selected_or_first_available_variant
  assign compare_at_price = current_variant.compare_at_price
  assign variant_price = current_variant.price
  assign show_compare = false
  assign savings_amount = 0
  assign savings_percent = 0

  if compare_at_price > variant_price
    assign show_compare = true
    assign savings_amount = compare_at_price | minus: variant_price
    assign savings_percent = savings_amount | times: 100.0 | divided_by: compare_at_price | round
  endif

  assign summary = blank
  assign summary_metafield = product_resource.metafields[section.settings.summary_metafield_namespace][section.settings.summary_metafield_key]

  if summary_metafield != blank
    assign summary = summary_metafield.value
  endif

  if summary == blank and section.settings.summary != blank
    assign summary = section.settings.summary
  endif

  assign show_limited_stock = false

  if section.settings.show_limited_stock_badge and current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= section.settings.limited_stock_threshold
    assign show_limited_stock = true
  endif

  assign has_benefits = false

  if section.settings.benefit_1_text != blank or section.settings.benefit_2_text != blank or section.settings.benefit_3_text != blank or section.settings.benefit_4_text != blank or section.settings.benefit_5_text != blank or section.settings.benefit_6_text != blank
    assign has_benefits = true
  endif

  assign has_testimonials = false

  if section.settings.testimonial_1_quote != blank or section.settings.testimonial_2_quote != blank or section.settings.testimonial_3_quote != blank or section.settings.testimonial_1_image != blank or section.settings.testimonial_2_image != blank or section.settings.testimonial_3_image != blank
    assign has_testimonials = true
  endif
%}

{% capture media_gallery %}
  {% content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: product_resource
  %}
{% endcapture %}

{% capture media_column %}
  <div class="main-product-assignment__media-wrap">
    <div class="main-product-assignment__media-inner">
      {{ media_gallery }}
    </div>

    <div
      class="main-product-assignment__trust-bar"
      role="region"
      aria-label="{{ section.settings.trust_bar_aria_label | escape }}"
      style="--product-assignment-trust-desktop-anchor: {{ section.settings.trust_bar_desktop_anchor_percent }}%;"
    >
      <ul class="main-product-assignment__trust-list list-unstyled">
        {% content_for 'blocks', closest.product: product_resource %}
      </ul>
    </div>
  </div>
{% endcapture %}

{% capture product_details %}
  <div
    id="ProductInformation-{{ section.id }}"
    class="main-product-assignment__details product-details sticky-content--desktop"
    data-testid="product-assignment-details"
  >
    <h1 class="main-product-assignment__title">
      {{ product_resource.title | escape }}
    </h1>

    {% if show_limited_stock or section.settings.viewing_message != blank %}
      <div
        class="main-product-assignment__badges"
        aria-label="Product highlights"
      >
        {% if show_limited_stock %}
          <span class="main-product-assignment__badge main-product-assignment__badge--stock">
            <span
              class="main-product-assignment__badge-icon main-product-assignment__badge-icon--stock"
              aria-hidden="true"
            ></span>
            {{ section.settings.limited_stock_label | escape }}
          </span>
        {% endif %}

        {% if section.settings.viewing_message != blank %}
          <span class="main-product-assignment__badge main-product-assignment__badge--viewing">
            <span
              class="main-product-assignment__badge-icon main-product-assignment__badge-icon--viewing"
              aria-hidden="true"
            ></span>
            {{ section.settings.viewing_message | escape }}
          </span>
        {% endif %}
      </div>
    {% endif %}

    {% if summary != blank %}
      <div class="main-product-assignment__summary rte">
        {{ summary }}
      </div>
    {% endif %}

    <div class="main-product-assignment__price-row">
      <product-price
        class="main-product-assignment__price"
        data-block-id="{{ section.id }}-assignment-price"
        data-product-id="{{ product_resource.id }}"
      >
        {% render 'price',
          product_resource: product_resource,
          show_sale_price_first: section.settings.show_sale_price_first
        %}

        {% if show_compare and section.settings.show_savings_badge %}
          <span class="main-product-assignment__savings-badge">
            {% if section.settings.savings_display == 'percent' %}
              Save {{ savings_percent }}% OFF
            {% else %}
              Save {{ savings_amount | money }} OFF
            {% endif %}
          </span>
        {% endif %}
      </product-price>
    </div>

    {% if has_benefits %}
      <div class="main-product-assignment__benefits">
        {% if section.settings.benefits_heading != blank %}
          <h2 class="main-product-assignment__benefits-title">
            {{ section.settings.benefits_heading | escape }}
          </h2>
        {% endif %}

        <div class="main-product-assignment__benefits-grid">
          {% if section.settings.benefit_1_text != blank or section.settings.benefit_1_icon != blank %}
            <div class="main-product-assignment__benefit">
              {% if section.settings.benefit_1_icon != blank %}
                {{
                  section.settings.benefit_1_icon
                  | image_url: width: 64
                  | image_tag:
                    class: 'main-product-assignment__benefit-icon',
                    loading: 'lazy',
                    alt: ''
                }}
              {% endif %}

              {% if section.settings.benefit_1_text != blank %}
                <div class="main-product-assignment__benefit-text">
                  {{ section.settings.benefit_1_text | escape | newline_to_br }}
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if section.settings.benefit_2_text != blank or section.settings.benefit_2_icon != blank %}
            <div class="main-product-assignment__benefit">
              {% if section.settings.benefit_2_icon != blank %}
                {{
                  section.settings.benefit_2_icon
                  | image_url: width: 64
                  | image_tag:
                    class: 'main-product-assignment__benefit-icon',
                    loading: 'lazy',
                    alt: ''
                }}
              {% endif %}

              {% if section.settings.benefit_2_text != blank %}
                <div class="main-product-assignment__benefit-text">
                  {{ section.settings.benefit_2_text | escape | newline_to_br }}
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if section.settings.benefit_3_text != blank or section.settings.benefit_3_icon != blank %}
            <div class="main-product-assignment__benefit">
              {% if section.settings.benefit_3_icon != blank %}
                {{
                  section.settings.benefit_3_icon
                  | image_url: width: 64
                  | image_tag:
                    class: 'main-product-assignment__benefit-icon',
                    loading: 'lazy',
                    alt: ''
                }}
              {% endif %}

              {% if section.settings.benefit_3_text != blank %}
                <div class="main-product-assignment__benefit-text">
                  {{ section.settings.benefit_3_text | escape | newline_to_br }}
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if section.settings.benefit_4_text != blank or section.settings.benefit_4_icon != blank %}
            <div class="main-product-assignment__benefit">
              {% if section.settings.benefit_4_icon != blank %}
                {{
                  section.settings.benefit_4_icon
                  | image_url: width: 64
                  | image_tag:
                    class: 'main-product-assignment__benefit-icon',
                    loading: 'lazy',
                    alt: ''
                }}
              {% endif %}

              {% if section.settings.benefit_4_text != blank %}
                <div class="main-product-assignment__benefit-text">
                  {{ section.settings.benefit_4_text | escape | newline_to_br }}
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if section.settings.benefit_5_text != blank or section.settings.benefit_5_icon != blank %}
            <div class="main-product-assignment__benefit">
              {% if section.settings.benefit_5_icon != blank %}
                {{
                  section.settings.benefit_5_icon
                  | image_url: width: 64
                  | image_tag:
                    class: 'main-product-assignment__benefit-icon',
                    loading: 'lazy',
                    alt: ''
                }}
              {% endif %}

              {% if section.settings.benefit_5_text != blank %}
                <div class="main-product-assignment__benefit-text">
                  {{ section.settings.benefit_5_text | escape | newline_to_br }}
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if section.settings.benefit_6_text != blank or section.settings.benefit_6_icon != blank %}
            <div class="main-product-assignment__benefit">
              {% if section.settings.benefit_6_icon != blank %}
                {{
                  section.settings.benefit_6_icon
                  | image_url: width: 64
                  | image_tag:
                    class: 'main-product-assignment__benefit-icon',
                    loading: 'lazy',
                    alt: ''
                }}
              {% endif %}

              {% if section.settings.benefit_6_text != blank %}
                <div class="main-product-assignment__benefit-text">
                  {{ section.settings.benefit_6_text | escape | newline_to_br }}
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="main-product-assignment__buy-button">
      {% render 'add-to-cart-button-with-form', product: product_resource %}
    </div>

    {% if has_testimonials %}
      <div class="testimonials-section">
        {% if section.settings.testimonials_heading != blank %}
          <h2 class="testimonials-section__title">
            {{ section.settings.testimonials_heading | escape }}
          </h2>
        {% endif %}

        <div class="swiper testimonials-slider">
          <div class="swiper-wrapper">
            {% if section.settings.testimonial_1_quote != blank or section.settings.testimonial_1_image != blank %}
              {% assign pop_img_1 = section.settings.testimonial_1_popup_image | default: section.settings.testimonial_1_image %}

              <div class="swiper-slide testimonial-card">
                <div
                  class="testimonial-card__avatar-wrapper"
                  data-media-type="{% if section.settings.testimonial_1_video_url != blank %}video{% else %}image{% endif %}"
                  data-media-url="{% if section.settings.testimonial_1_video_url != blank %}{{ section.settings.testimonial_1_video_url }}{% elsif pop_img_1 != blank %}{{ pop_img_1 | image_url: width: 1200 }}{% endif %}"
                >
                  {% if section.settings.testimonial_1_image != blank %}
                    {{
                      section.settings.testimonial_1_image
                      | image_url: width: 200
                      | image_tag:
                        class: 'testimonial-card__avatar',
                        loading: 'lazy',
                        alt: section.settings.testimonial_1_author
                    }}
                  {% endif %}

                  {% if section.settings.testimonial_1_video_url != blank %}
                    <span class="testimonial-card__play-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </span>
                  {% endif %}
                </div>

                {% if section.settings.testimonial_1_quote != blank %}
                  <div class="testimonial-card__quote">
                    {{ section.settings.testimonial_1_quote }}
                  </div>
                {% endif %}

                {% if section.settings.testimonial_1_author != blank %}
                  <p class="testimonial-card__author">
                    {{ section.settings.testimonial_1_author | escape }}
                  </p>
                {% endif %}
              </div>
            {% endif %}

            {% if section.settings.testimonial_2_quote != blank or section.settings.testimonial_2_image != blank %}
              {% assign pop_img_2 = section.settings.testimonial_2_popup_image | default: section.settings.testimonial_2_image %}

              <div class="swiper-slide testimonial-card">
                <div
                  class="testimonial-card__avatar-wrapper"
                  data-media-type="{% if section.settings.testimonial_2_video_url != blank %}video{% else %}image{% endif %}"
                  data-media-url="{% if section.settings.testimonial_2_video_url != blank %}{{ section.settings.testimonial_2_video_url }}{% elsif pop_img_2 != blank %}{{ pop_img_2 | image_url: width: 1200 }}{% endif %}"
                >
                  {% if section.settings.testimonial_2_image != blank %}
                    {{
                      section.settings.testimonial_2_image
                      | image_url: width: 200
                      | image_tag:
                        class: 'testimonial-card__avatar',
                        loading: 'lazy',
                        alt: section.settings.testimonial_2_author
                    }}
                  {% endif %}

                  {% if section.settings.testimonial_2_video_url != blank %}
                    <span class="testimonial-card__play-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </span>
                  {% endif %}
                </div>

                {% if section.settings.testimonial_2_quote != blank %}
                  <div class="testimonial-card__quote">
                    {{ section.settings.testimonial_2_quote }}
                  </div>
                {% endif %}

                {% if section.settings.testimonial_2_author != blank %}
                  <p class="testimonial-card__author">
                    {{ section.settings.testimonial_2_author | escape }}
                  </p>
                {% endif %}
              </div>
            {% endif %}

            {% if section.settings.testimonial_4_quote != blank or section.settings.testimonial_3_image != blank %}
              {% assign pop_img_3 = section.settings.testimonial_3_popup_image | default: section.settings.testimonial_3_image %}

              <div class="swiper-slide testimonial-card">
                <div
                  class="testimonial-card__avatar-wrapper"
                  data-media-type="{% if section.settings.testimonial_3_video_url != blank %}video{% else %}image{% endif %}"
                  data-media-url="{% if section.settings.testimonial_3_video_url != blank %}{{ section.settings.testimonial_3_video_url }}{% elsif pop_img_3 != blank %}{{ pop_img_3 | image_url: width: 1200 }}{% endif %}"
                >
                  {% if section.settings.testimonial_3_image != blank %}
                    {{
                      section.settings.testimonial_3_image
                      | image_url: width: 200
                      | image_tag:
                        class: 'testimonial-card__avatar',
                        loading: 'lazy',
                        alt: section.settings.testimonial_3_author
                    }}
                  {% endif %}

                  {% if section.settings.testimonial_3_video_url != blank %}
                    <span class="testimonial-card__play-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </span>
                  {% endif %}
                </div>

                {% if section.settings.testimonial_3_quote != blank %}
                  <div class="testimonial-card__quote">
                    {{ section.settings.testimonial_3_quote }}
                  </div>
                {% endif %}

                {% if section.settings.testimonial_3_author != blank %}
                  <p class="testimonial-card__author">
                    {{ section.settings.testimonial_3_author | escape }}
                  </p>
                {% endif %}
              </div>
            {% endif %}

            {% if section.settings.testimonial_4_quote != blank or section.settings.testimonial_4_image != blank %}
              {% assign pop_img_4 = section.settings.testimonial_4_popup_image | default: section.settings.testimonial_4_image %}

              <div class="swiper-slide testimonial-card">
                <div
                  class="testimonial-card__avatar-wrapper"
                  data-media-type="{% if section.settings.testimonial_4_video_url != blank %}video{% else %}image{% endif %}"
                  data-media-url="{% if section.settings.testimonial_4_video_url != blank %}{{ section.settings.testimonial_4_video_url }}{% elsif pop_img_4 != blank %}{{ pop_img_4 | image_url: width: 1200 }}{% endif %}"
                >
                  {% if section.settings.testimonial_4_image != blank %}
                    {{
                      section.settings.testimonial_4_image
                      | image_url: width: 200
                      | image_tag:
                        class: 'testimonial-card__avatar',
                        loading: 'lazy',
                        alt: section.settings.testimonial_4_author
                    }}
                  {% endif %}

                  {% if section.settings.testimonial_4_video_url != blank %}
                    <span class="testimonial-card__play-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </span>
                  {% endif %}
                </div>

                {% if section.settings.testimonial_4_quote != blank %}
                  <div class="testimonial-card__quote">
                    {{ section.settings.testimonial_4_quote }}
                  </div>
                {% endif %}

                {% if section.settings.testimonial_4_author != blank %}
                  <p class="testimonial-card__author">
                    {{ section.settings.testimonial_4_author | escape }}
                  </p>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      <div id="TestimonialModal-{{ section.id }}" class="testimonial-modal" aria-hidden="true">
        <div class="testimonial-modal__content">
          <button type="button" class="testimonial-modal__close" aria-label="Close modal">&times;</button>
          <div class="testimonial-modal__body"></div>
        </div>
      </div>
    {% endif %}

    {% comment %} {% render 'product-tabs' %} {% endcomment %}
  </div>
{% endcapture %}

{% render 'deferred-media-product-model-styles' %}
{% render 'deferred-media-video-styles' %}
{% render 'price-styles' %}

{% render 'product-information-content',
  product: product_resource,
  section_id: section.id,
  settings: section.settings,
  media_gallery: media_column,
  product_details: product_details,
  additional_blocks: ''
%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

{{ 'testimonials-modal.js' | asset_url | script_tag }}

<script type="application/ld+json">
  {{ product_resource | structured_data }}
</script>

{% schema %}
{
  "name": "Main assignment product",
  "tag": "section",
  "class": "main-product-assignment",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Section width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "Page width"
        },
        {
          "value": "content-full-width",
          "label": "Full width"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "Media position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "Equal columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "Limit product details width",
      "default": false
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Product summary"
    },
    {
      "type": "text",
      "id": "summary_metafield_namespace",
      "label": "Summary metafield namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "summary_metafield_key",
      "label": "Summary metafield key",
      "default": "summary"
    },
    {
      "type": "richtext",
      "id": "summary",
      "label": "Summary fallback (theme editor)",
      "info": "Used when the product metafield is empty."
    },
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "checkbox",
      "id": "show_limited_stock_badge",
      "label": "Show limited stock badge",
      "default": true
    },
    {
      "type": "range",
      "id": "limited_stock_threshold",
      "label": "Limited stock threshold",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 10
    },
    {
      "type": "text",
      "id": "limited_stock_label",
      "label": "Limited stock label",
      "default": "Limited Stock"
    },
    {
      "type": "text",
      "id": "viewing_message",
      "label": "Viewing message",
      "info": "Static merchandising copy only. Leave blank to hide."
    },
    {
      "type": "header",
      "content": "Pricing"
    },
    {
      "type": "checkbox",
      "id": "show_sale_price_first",
      "label": "Show sale price before compare-at price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_savings_badge",
      "label": "Show savings badge",
      "default": true
    },
    {
      "type": "select",
      "id": "savings_display",
      "label": "Savings badge format",
      "options": [
        {
          "value": "amount",
          "label": "Dollar amount"
        },
        {
          "value": "percent",
          "label": "Percent"
        }
      ],
      "default": "amount"
    },
    {
      "type": "header",
      "content": "Benefits"
    },
    {
      "type": "text",
      "id": "benefits_heading",
      "label": "Benefits heading",
      "default": "Why you need this?"
    },
    {
      "type": "image_picker",
      "id": "benefit_1_icon",
      "label": "Benefit 1 icon"
    },
    {
      "type": "textarea",
      "id": "benefit_1_text",
      "label": "Benefit 1 text"
    },
    {
      "type": "image_picker",
      "id": "benefit_2_icon",
      "label": "Benefit 2 icon"
    },
    {
      "type": "textarea",
      "id": "benefit_2_text",
      "label": "Benefit 2 text"
    },
    {
      "type": "image_picker",
      "id": "benefit_3_icon",
      "label": "Benefit 3 icon"
    },
    {
      "type": "textarea",
      "id": "benefit_3_text",
      "label": "Benefit 3 text"
    },
    {
      "type": "image_picker",
      "id": "benefit_4_icon",
      "label": "Benefit 4 icon"
    },
    {
      "type": "textarea",
      "id": "benefit_4_text",
      "label": "Benefit 4 text"
    },
    {
      "type": "image_picker",
      "id": "benefit_5_icon",
      "label": "Benefit 5 icon"
    },
    {
      "type": "textarea",
      "id": "benefit_5_text",
      "label": "Benefit 5 text"
    },
    {
      "type": "image_picker",
      "id": "benefit_6_icon",
      "label": "Benefit 6 icon"
    },
    {
      "type": "textarea",
      "id": "benefit_6_text",
      "label": "Benefit 6 text"
    },
    {
      "type": "header",
      "content": "Testimonials"
    },
    {
      "type": "text",
      "id": "testimonials_heading",
      "label": "Testimonials heading",
      "default": "Real People. Real Healing."
    },
    {
      "type": "image_picker",
      "id": "testimonial_1_image",
      "label": "Testimonial 1 Avatar"
    },
    {
      "type": "image_picker",
      "id": "testimonial_1_popup_image",
      "label": "Testimonial 1 Popup Image (Optional)",
      "info": "Fallback: uses avatar if empty"
    },
    {
      "type": "url",
      "id": "testimonial_1_video_url",
      "label": "Testimonial 1 Video URL (Optional)",
      "info": "MP4 file, YouTube or Vimeo URL"
    },
    {
      "type": "richtext",
